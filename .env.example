# Daredevil – Environment variables template
# Copy to .env.local and fill in your values. Never commit .env.local.

# Supabase (auth & database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google / Gemini (AI, video analysis, RAG, embeddings)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: extra keys for rate-limit distribution (GEMINI_API_KEY_1, GOOGLE_API_KEY_1, etc.)
# GEMINI_API_KEY_1=
# GOOGLE_API_KEY_1=

# Pinecone (vector DB for RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ufdr-rag

# Twilio (WhatsApp / SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# Resend (email)
RESEND_API_KEY=

# Vercel Blob (file uploads) – set automatically on Vercel
# BLOB_READ_WRITE_TOKEN=

# Vercel (set automatically on Vercel)
# VERCEL_URL=
# VERCEL_ENV=
